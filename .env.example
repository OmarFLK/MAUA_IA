# Chave pessoal da API Barô. Preencha somente no .env local; nunca publique a chave.
BARO_API_KEY=
BARO_BASE_URL=https://ia.maua.br/api/v1
BARO_MODEL=google/gemma-3-27b
BARO_SUPPORTS_THINKING=false
BARO_TIMEOUT_SECONDS=120

# Origens do frontend, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL local. No Render, use a connection string pooled do Neon em DATABASE_URL.
# postgres:// e postgresql:// são normalizadas; sslmode=require e channel_binding também são tratados.
DATABASE_URL=postgresql+asyncpg://maua:troque-esta-senha@localhost:5432/maua_ai
DATABASE_AUTO_CREATE=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# Use a mesma senha da URL acima no Docker Compose local.
POSTGRES_PASSWORD=

# Gere um valor longo e aleatório antes de publicar.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Cria as 3 contas demonstrativas. Use false em produção.
SEED_TEST_USERS=false
# Se habilitar as contas de demonstracao, defina uma senha local de pelo menos 8 caracteres.
SEED_TEST_PASSWORD=

# Banco analítico local gerado por: python -m scripts.ingest_semob
SEMOB_DATABASE_PATH=data/database/semob.duckdb
SEMOB_RAG_PATH=data/database/rag.sqlite
SEMOB_MEMORY_RETENTION_DAYS=30

# O endpoint de inspeção de sessão só existe em development.
APP_ENVIRONMENT=development
