# Solicite esta URL ao suporte da Mauá e cole aqui sem a barra final.
MAUA_AI_BASE_URL=https://servidor-interno-da-maua.exemplo/v1

# A API exige um valor, mas não autentica esta chave.
MAUA_AI_API_KEY=maua
MAUA_AI_MODEL=qwen/qwen3.8-27b
MAUA_AI_TIMEOUT_SECONDS=120

# Origens do frontend, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL local (compatível também com Supabase, Neon e outros provedores).
DATABASE_URL=postgresql+asyncpg://maua:maua_dev_password@localhost:5432/maua_ai

# Gere um valor longo e aleatório antes de publicar.
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRE_MINUTES=480

# Cria as 3 contas demonstrativas. Use false em produção.
SEED_TEST_USERS=true
