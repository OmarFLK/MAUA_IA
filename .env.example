# Solicite esta URL ao suporte da Mauá e cole aqui sem a barra final.
MAUA_AI_BASE_URL=

# Solicite o valor ao responsavel e preencha somente no .env local.
MAUA_AI_API_KEY=
MAUA_AI_MODEL=google/gemma-3-27b
MAUA_AI_SUPPORTS_THINKING=false
MAUA_AI_TIMEOUT_SECONDS=120

# Origens do frontend, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite local: instale requirements-dev.txt. Para PostgreSQL, configure a URL somente no .env.
DATABASE_URL=sqlite+aiosqlite:///./maua_ai.db
# Necessario apenas para o PostgreSQL do Docker Compose.
POSTGRES_PASSWORD=

# Gere um valor longo e aleatório antes de publicar.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Cria as 3 contas demonstrativas. Use false em produção.
SEED_TEST_USERS=false
# Se habilitar as contas de demonstracao, defina uma senha local de pelo menos 8 caracteres.
SEED_TEST_PASSWORD=

# Banco analítico local gerado por: python -m scripts.ingest_semob
SEMOB_DATABASE_PATH=data/database/semob.duckdb
SEMOB_RAG_PATH=data/database/rag.sqlite
SEMOB_MEMORY_PATH=data/database/memory.sqlite
SEMOB_MEMORY_RETENTION_DAYS=30
SEMOB_SESSION_PATH=data/database/session.sqlite

# O endpoint de inspeção de sessão só existe em development.
APP_ENVIRONMENT=development
